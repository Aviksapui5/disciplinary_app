<mvc:View
    controllerName="com.emp.discip.employeedisciplinarycase.controller.employeeDisplay"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
    height="100%">

    <SplitApp id="splitApp" initialMaster="masterPage" initialDetail="detailPage" masterButtonText=" " class="empSplitApp">

        <!-- ================= MASTER : CASES LIST ================= -->
        <masterPages>
            <Page id="masterPage" title="Disciplinary Cases">
                <List
                    id="caseList"
                    items="{
                        path: '/Cases',
                        sorter: { path: 'caseID' }
                    }"
                    mode="SingleSelectMaster"
                    selectionChange="onCaseSelect"
                    updateFinished="onListUpdateFinished"
                    growing="true"
                    growingThreshold="20"
                    noDataText="No cases found">

                    <headerToolbar>
                        <Toolbar>
                            <Title text="Cases"/>
                        </Toolbar>
                    </headerToolbar>

                    <infoToolbar>
                        <Toolbar>
                            <SearchField
                                placeholder="Case ID, category or status"
                                liveChange="onSearch"
                                search="onSearch"
                                width="100%"/>
                        </Toolbar>
                    </infoToolbar>

                    <ObjectListItem
                        title="{caseID}"
                        type="Active">
                        <firstStatus>
                            <ObjectStatus
                                text="{path: 'status_statusCode', formatter: '.formatter.statusText'}"
                                state="{path: 'status_statusCode', formatter: '.formatter.statusState'}"/>
                        </firstStatus>
                        <attributes>
                            <ObjectAttribute text="{category/categoryName}"/>
                            <ObjectAttribute text="Incident: {incidentDate}"/>
                        </attributes>
                    </ObjectListItem>
                </List>
            </Page>
