<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <TableSelectDialog
        title="Select Employee"
        contentWidth="55rem"
        growing="true"
        items="{
            path: '/Employees',
            parameters: {
                $select: 'employeeID,firstName,lastName,displayName,email,position,managerID,companyCode,location,employmentStatus,hireDate,department_departmentID',
                $expand: 'department'
            }
        }"
        search=".onEmployeeSearch"
        liveChange=".onEmployeeSearch"
        confirm=".onEmployeeConfirm"
        cancel=".onEmployeeDialogCancel">
        <columns>
            <Column><Text text="Employee ID"/></Column>
            <Column><Text text="Name"/></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Department"/></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Designation"/></Column>
        </columns>
        <ColumnListItem type="Active">
            <cells>
                <ObjectIdentifier title="{employeeID}"/>
                <Text text="{displayName}"/>
                <Text text="{department/departmentName}"/>
                <Text text="{position}"/>
            </cells>
        </ColumnListItem>
    </TableSelectDialog>
</core:FragmentDefinition>