
<mvc:View
    controllerName="disciplinary.app.disciplinarycaseapp.controller.CreateEmployee"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:layout="sap.ui.layout">

    <Page
        id="createPage"
        title="Create Disciplinary Case"
          showNavButton="true" navButtonPress="onCancel">
                <content>
                    <VBox  class="sapUiSmallMarginTop sapUiMediumMarginBeginEnd">
                        <!-- ================================= -->
                        <!-- STEP 1 : SELECT EMPLOYEE         -->
                        <!-- ================================= -->
                        <Panel
                            id="employeePanel"
                            headerText="Select employee"
                            class="sapUiSmallMarginBottom">

                            <content>

                                <VBox
                                    width="100%"
                                    class="sapUiResponsiveContentPadding">
                                    <!-- EMPLOYEE SELECTION -->
                                    <HBox
                                        width="100%"
                                        alignItems="Center"
                                        wrap="NoWrap"
                                        class="sapUiSmallMarginTopBottom">

                                        <Label
                                            text="Employee"
                                            required="true"
                                            width="5rem"/>

                                        <!-- <Input
                                            id="employeeInput"
                                            placeholder="Search by ID Or name"
                                            showSuggestion="true"
                                            filterSuggests="false"
                                            startSuggestion="1"
                                            showValueHelp="true"
                                            valueHelpOnly="false"
                                            valueHelpRequest=".onEmployeeValueHelp"
                                            suggest=".onEmployeeSuggest"
                                            suggestionItemSelected=".onEmployeeSuggestionSelected"
                                            suggestionItems="{master>/employees}"
                                            value="{= ${case>/employee/employeeID}
                                                ? ${case>/employee/displayName}
                                                + ' (' + ${case>/employee/employeeID} + ')'
                                                : '' }">
                                             <layoutData>
                                                    <FlexItemData
                                                        growFactor="0"
                                                        shrinkFactor="1"
                                                        baseSize="28rem"/>
                                                </layoutData>


                                            <suggestionItems>
                                                <SuggestionItem
                                                    key="{master>employeeID}"
                                                    text="{master>displayName}"
                                                    description="{master>employeeID} | {master>departmentName} | {master>position}"/>
                                            </suggestionItems>

                                        </Input> -->
                                        <Input
                                            id="employeeInput"
                                            placeholder="Search by ID Or name"
                                            showSuggestion="true"
                                            filterSuggests="false"
                                            startSuggestion="1"
                                            showValueHelp="true"
                                            valueHelpOnly="false"
                                            valueHelpRequest=".onEmployeeValueHelp"
                                            suggest=".onEmployeeSuggest"
                                            suggestionItemSelected=".onEmployeeSuggestionSelected"
                                            value="{= ${case>/employee/employeeID}
                                                ? ${case>/employee/displayName}
                                                + ' (' + ${case>/employee/employeeID} + ')'
                                                : '' }">
                                            <layoutData>
                                                <FlexItemData growFactor="0" shrinkFactor="1" baseSize="28rem"/>
                                            </layoutData>
                                        </Input>

                                        <Button
                                            icon="sap-icon://decline"
                                            type="Transparent"
                                            tooltip="Remove selected employee"
                                            enabled="{= !!${case>/employee/employeeID} }"
                                            press=".onClearEmployee"
                                            class="sapUiTinyMarginBegin"/>

                                    </HBox>
                                    <!-- EMPLOYEE DETAILS -->
                                    <layout:Grid
                                        xmlns:layout="sap.ui.layout"
                                        width="100%"
                                        defaultSpan="XL6 L6 M6 S12"
                                        hSpacing="2"
                                        vSpacing="2"
                                        visible="{= !!${case>/employee/employeeID} }">


                                        <!-- ================================= -->
                                        <!-- EMPLOYEE AVATAR                  -->
                                        <!-- ================================= -->

                                        <VBox
                                            alignItems="Center"
                                            justifyContent="Start"
                                            class="sapUiSmallMarginTop">

                                            <layoutData>
                                                <layout:GridData span="XL1 L2 M12 S12"/>
                                            </layoutData>

                                            <Avatar
                                                displaySize="XL"
                                                displayShape="Circle"
                                                backgroundColor="Accent6"
                                                initials="{path:'case>/employee/displayName',
                                                    formatter:'.formatter.initials'}"/>

                                        </VBox>


                                        <!-- ================================= -->
                                        <!-- EMPLOYEE INFORMATION             -->
                                        <!-- ================================= -->

                                        <VBox
                                            width="100%"
                                            class="sapUiSmallMarginTop">

                                            <layoutData>
                                                <layout:GridData span="XL5 L5 M6 S12"/>
                                            </layoutData>

                                            <Title
                                                text="Employee information"
                                                level="H5"
                                                class="sapUiSmallMarginBottom"/>


                                            <!-- EMPLOYEE ID -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Employee ID:"
                                                    width="8rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{case>/employee/employeeID}"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>


                                            <!-- NAME -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Name:"
                                                    width="8rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{case>/employee/displayName}"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>


                                            <!-- EMAIL -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Email:"
                                                    width="8rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{case>/employee/email}"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>


                                            <!-- DESIGNATION -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Designation:"
                                                    width="8rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{case>/employee/position}"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>


                                            <!-- EMPLOYMENT STATUS -->
                                            <HBox
                                                width="100%"
                                                alignItems="Center"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Status:"
                                                    width="8rem"
                                                    textAlign="Begin"/>

                                                <ObjectStatus
                                                    text="{case>/employee/employmentStatus}"
                                                    state="Success"
                                                    inverted="true"
                                                    visible="{= !!${case>/employee/employmentStatus} }"/>

                                            </HBox>

                                        </VBox>


                                        <!-- ================================= -->
                                        <!-- ORGANIZATION INFORMATION         -->
                                        <!-- ================================= -->

                                        <VBox
                                            width="100%"
                                            class="sapUiSmallMarginTop">

                                            <layoutData>
                                                <layout:GridData span="XL6 L5 M6 S12"/>
                                            </layoutData>

                                            <Title
                                                text="Organization"
                                                level="H5"
                                                class="sapUiSmallMarginBottom"/>


                                            <!-- DEPARTMENT -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Department:"
                                                    width="9rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{= ${case>/employee/departmentID}
                                                        ? ${case>/employee/departmentID}
                                                        + ' - '
                                                        + ${case>/employee/departmentName}
                                                        : '' }"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>


                                            <!-- LOCATION -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Location:"
                                                    width="9rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{case>/employee/location}"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>


                                            <!-- COMPANY CODE -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Company code:"
                                                    width="9rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{case>/employee/companyCode}"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>


                                            <!-- LINE MANAGER -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Line manager:"
                                                    width="9rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{case>/employee/managerID}"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>


                                            <!-- HIRE DATE -->
                                            <HBox
                                                width="100%"
                                                alignItems="Start"
                                                class="sapUiTinyMarginBottom">

                                                <Label
                                                    text="Hire date:"
                                                    width="9rem"
                                                    textAlign="Begin"/>

                                                <Text
                                                    text="{path:'case>/employee/hireDate',
                                                        type:'sap.ui.model.type.Date',
                                                        formatOptions:{
                                                            source:{pattern:'yyyy-MM-dd'},
                                                            style:'medium'
                                                        }}"
                                                    wrapping="true"
                                                    width="100%"/>

                                            </HBox>

                                        </VBox>

                                    </layout:Grid>

                                </VBox>

                            </content>

                        </Panel>
                        <!-- ================================= -->
                        <!-- STEP 2 : CASE DETAILS             -->
                        <!-- ================================= -->
                        <Panel
                            id="caseDetailsPanel"
                            headerText="Case details"
                            class="sapUiSmallMarginBottom">

                            <content>
                                <VBox class="sapUiSmallMargin">

                                    
                                    <!-- ALLEGATION AND DATES - SINGLE FORM WITH TWO SECTIONS -->
                                    <VBox width="80%" class="sapUiMediumMarginBegin">
                                        <form:Form
                                            id="allegationDatesForm"
                                            editable="true">

                                            <form:layout>
                                                <form:ResponsiveGridLayout
                                                    labelSpanXL="12"
                                                    labelSpanL="12"
                                                    labelSpanM="12"
                                                    labelSpanS="12"
                                                    emptySpanXL="0"
                                                    emptySpanL="0"
                                                    emptySpanM="0"
                                                    emptySpanS="0"
                                                    columnsXL="2"
                                                    columnsL="2"
                                                    columnsM="2"
                                                    singleContainerFullSize="false"/>
                                            </form:layout>

                                            <form:formContainers>

                                                <!-- ALLEGATION SECTION -->
                                                <form:FormContainer
                                                    title="Allegation">

                                                    <form:formElements>

                                                        <form:FormElement>
                                                            <form:label>
                                                                <Label
                                                                    text="Allegation category"
                                                                    required="true"
                                                                    labelFor="categorySelect"/>
                                                            </form:label>

                                                           <form:fields>
                                                                <Select
                                                                    id="categorySelect"
                                                                    width="75%"
                                                                    forceSelection="false"
                                                                    selectedKey="{case>/categoryID}"
                                                                    change=".onCategoryChange">

                                                                    <core:Item
                                                                        key="C01"
                                                                        text="Absenteeism"/>

                                                                    <core:Item
                                                                        key="C02"
                                                                        text="Misconduct"/>

                                                                    <core:Item
                                                                        key="C03"
                                                                        text="Harassment"/>

                                                                    <core:Item
                                                                        key="C04"
                                                                        text="Policy Violation"/>

                                                                    <core:Item
                                                                        key="C05"
                                                                        text="Performance"/>

                                                                </Select>
                                                            </form:fields>
                                                        </form:FormElement>

                                                        <form:FormElement>
                                                            <form:label>
                                                                <Label
                                                                    text="Incident location"
                                                                    labelFor="incidentLocation"/>
                                                            </form:label>

                                                            <form:fields>
                                                                <Input
                                                                    id="incidentLocation"
                                                                    width="75%"
                                                                    value="{case>/incidentLocation}"
                                                                    maxLength="150"
                                                                    placeholder="Enter incident location"/>
                                                            </form:fields>
                                                        </form:FormElement>

                                                    </form:formElements>

                                                </form:FormContainer>


                                                <!-- DATES SECTION -->
                                                <form:FormContainer
                                                    title="Dates">

                                                    <form:formElements>

                                                        <form:FormElement>
                                                            <form:label>
                                                                <Label
                                                                    text="Incident date"
                                                                    required="true"
                                                                    labelFor="incidentDate"/>
                                                            </form:label>

                                                            <form:fields>
                                                                <DatePicker
                                                                    id="incidentDate"
                                                                    width="70%"
                                                                    value="{case>/incidentDate}"
                                                                    valueFormat="yyyy-MM-dd"
                                                                    displayFormat="medium"
                                                                    placeholder="Select incident date"/>
                                                            </form:fields>
                                                        </form:FormElement>

                                                        <form:FormElement>
                                                            <form:label>
                                                                <Label
                                                                    text="Reported date"
                                                                    required="true"
                                                                    labelFor="reportedDate"/>
                                                            </form:label>

                                                            <form:fields>
                                                                <DatePicker
                                                                    id="reportedDate"
                                                                    width="70%"
                                                                    value="{case>/reportedDate}"
                                                                    valueFormat="yyyy-MM-dd"
                                                                    displayFormat="medium"
                                                                    placeholder="Select reported date"/>
                                                            </form:fields>
                                                        </form:FormElement>

                                                    </form:formElements>

                                                </form:FormContainer>

                                            </form:formContainers>

                                        </form:Form>
                                    </VBox>



                                    <!-- CASE DESCRIPTION -->
                                    <VBox
                                        width="90%"
                                        class="sapUiLargeMarginBegin">

                                        <Label
                                            text="Case description:"
                                            required="true"
                                            labelFor="caseDescription"/>

                                        <TextArea
                                            id="caseDescription"
                                            width="74%"
                                            rows="5"
                                            growing="true"
                                            growingMaxLines="10"
                                            maxLength="5000"
                                            showExceededText="true"
                                            value="{case>/caseDescription}"
                                            placeholder="Describe the incident in detail"/>
                                    </VBox>

                                </VBox>
                            </content>

                        </Panel>
                         <!-- ================================= -->
                        <!-- STEP 2 : CASE DETAILS             -->
                        <!-- ================================= -->
                        <Panel
                            id="supportDocumentsPanel"
                            headerText="Supporting Documents"
                            class="sapUiSmallMarginBottom">

                            <content>
                                <VBox class="sapUiSmallMargin">
                                 <!-- SUPPORTING DOCUMENTS -->
                                    <VBox>
                                        <Table
                                            id="documentsTable"
                                            items="{case>/documents}"
                                            noDataText="No documents uploaded yet. Use Upload to add supporting documents.">

                                            <headerToolbar>
                                                <OverflowToolbar>
                                                    <Title text="{= 'Documents (' + ${case>/documents}.length + ')' }" level="H5"/>
                                                    <ToolbarSpacer/>
                                                    <SearchField
                                                        width="14rem"
                                                        placeholder="Search"
                                                        liveChange=".onDocumentSearch"
                                                        search=".onDocumentSearch"/>
                                                    <ToolbarSeparator/>
                                                    <u:FileUploader
                                                        id="fileUploader"
                                                        name="myFileUpload"
                                                        buttonOnly="true"
                                                        buttonText="Upload"
                                                        icon="sap-icon://upload"
                                                        style="Transparent"
                                                        multiple="true"
                                                        uploadOnChange="false"
                                                        fileType="pdf,doc,docx,xls,xlsx,jpg,jpeg,png,txt"
                                                        maximumFileSize="10"
                                                        sameFilenameAllowed="true"
                                                        tooltip="Select documents to attach"
                                                        change=".onFileChange"
                                                        typeMissmatch=".onTypeMissmatch"
                                                        fileSizeExceed=".onFileSizeExceed"/>
                                                </OverflowToolbar>
                                            </headerToolbar>

                                            <columns>
                                                <Column><Text text="File Name"/></Column>
                                                <Column width="6rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Type"/></Column>
                                                <Column width="7rem"><Text text="Size"/></Column>
                                                <Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Uploaded On"/></Column>
                                                <Column width="3rem" hAlign="End"/>
                                            </columns>

                                            <items>
                                                <ColumnListItem vAlign="Middle">
                                                    <cells>
                                                        <HBox alignItems="Center">
                                                            <Avatar
                                                                src="{case>thumbnail}"
                                                                displaySize="M"
                                                                displayShape="Square"
                                                                backgroundColor="Placeholder"
                                                                imageFitType="Cover"
                                                                tooltip="Preview"
                                                                press=".onDocumentPreview"
                                                                class="sapUiSmallMarginEnd"/>
                                                            <Link text="{case>fileName}" wrapping="true" press=".onDocumentPreview"/>
                                                        </HBox>
                                                        <Text text="{case>extension}"/>
                                                        <Text text="{case>sizeText}"/>
                                                        <Text text="{path:'case>uploadedOn', type:'sap.ui.model.type.DateTime',
                                                                    formatOptions:{style:'medium'}}"/>
                                                        <Button
                                                            icon="sap-icon://decline"
                                                            type="Transparent"
                                                            tooltip="Remove file"
                                                            press=".onDocumentRemove"/>
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>

                                        <Text
                                            text="Allowed: PDF, DOC, DOCX, XLS, XLSX, JPG, PNG, TXT. Max 10 MB per file, up to 10 files."
                                            class="sapUiTinyMarginTop"/>
                                    </VBox>
                                 </VBox>
                            </content>

                        </Panel>
                    </VBox>
                </content>
                <!-- ================================= -->
                <!-- FOOTER ACTION BUTTONS             -->
                <!-- ================================= -->
                <footer>
                    <OverflowToolbar>

                        <ToolbarSpacer/>

                        <Button
                            id="cancelButton"
                            text="Cancel"
                            type="Default"
                            press=".onCancel"/>

                        <Button
                            id="previewButton"
                            text="Preview"
                            icon="sap-icon://show"
                            type="Emphasized"
                            press=".onPreview"
                            class="sapUiTinyMarginBegin"/>

                    </OverflowToolbar>
                </footer>

    </Page>

</mvc:View>
