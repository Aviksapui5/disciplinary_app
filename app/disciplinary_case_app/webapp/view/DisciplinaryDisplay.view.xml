<mvc:View
    controllerName="disciplinary.app.disciplinarycaseapp.controller.DisciplinaryDisplay"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar">

    <Page
        id="page"
        title="{i18n>title}"
        class="sapUiResponsiveContentPadding">

        <content>

            <VBox width="100%" class="sapUiSmallMarginBottom">

                <!-- Smart Filter Bar -->
                <smartFilterBar:SmartFilterBar
                    id="smartFilterBar"
                    entitySet=""
                    persistencyKey="DisciplinaryEmployeeFilter"
                    useToolbar="false"
                    showGoOnFB="true"
                    showClearOnFB="true"
                    search="onSearch"
                    enableBasicSearch="true">

                    <smartFilterBar:controlConfiguration>

                        <smartFilterBar:ControlConfiguration
                            key="displayName"
                            label="Employee Name"
                            visibleInAdvancedArea="false"
                            index="0"/>

                        <smartFilterBar:ControlConfiguration
                            key="department_departmentID"
                            label="Department"
                            visibleInAdvancedArea="false"
                            index="1"/>

                        <smartFilterBar:ControlConfiguration
                            key="employmentStatus"
                            label="Employment Status"
                            visibleInAdvancedArea="false"
                            index="2"/>

                    </smartFilterBar:controlConfiguration>

                </smartFilterBar:SmartFilterBar>

                <!-- Employee Responsive Table -->
                <Panel
                    expandable="false"
                    class="sapUiNoContentPadding sapUiSmallMarginTop">

                    <headerToolbar>
                        <OverflowToolbar>

                            <Title
                                text="Employees"
                                level="H3"/>

                            <ToolbarSpacer/>

                            <Button
                                text="Create Case"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press="onCreateEmployee"/>

                        </OverflowToolbar>
                    </headerToolbar>

                    <content>

                        <Table
                            id="employeeTable"
                            items=""
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="10"
                            sticky="ColumnHeaders,HeaderToolbar"
                            mode="None"
                            width="100%"
                            noDataText="No employee records found">

                            <columns>

                                <Column width="11rem">
                                    <Text text="Employee ID"/>
                                </Column>

                                <Column minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Employee Name"/>
                                </Column>

                                <Column minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Email"/>
                                </Column>

                                <Column minScreenWidth="Desktop"
                                    demandPopin="true">
                                    <Text text="Position"/>
                                </Column>

                                <Column minScreenWidth="Desktop"
                                    demandPopin="true">
                                    <Text text="Department"/>
                                </Column>

                                <Column minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Company Code"/>
                                </Column>

                                <Column minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Location"/>
                                </Column>

                                <Column>
                                    <Text text="Status"/>
                                </Column>

                            </columns>

                            <items>
                                <ColumnListItem
                                    type="Navigation"
                                    press="onEmployeePress">

                                    <cells>

                                        <ObjectIdentifier
                                            title="{employeeID}"/>

                                        <Text text="{displayName}"/>

                                        <Text text="{email}"/>

                                        <Text text="{position}"/>

                                        <Text
                                            text="{department}"/>

                                        <Text text="{companyCode}"/>

                                        <Text text="{location}"/>

                                        <!-- <ObjectStatus
                                            text="{v4>employmentStatus}"
                                            state="{
                                                path: 'v4>employmentStatus',
                                                formatter: '.formatStatus'
                                            }"/> -->

                                    </cells>

                                </ColumnListItem>
                            </items>

                        </Table>

                    </content>
                </Panel>

            </VBox>

        </content>
    </Page>

</mvc:View>
