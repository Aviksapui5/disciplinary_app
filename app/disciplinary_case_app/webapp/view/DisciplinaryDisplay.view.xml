<mvc:View
    controllerName="disciplinary.app.disciplinarycaseapp.controller.DisciplinaryDisplay"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ui="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar">

    <Page
        id="page"
        title="{i18n>title}"
        class="sapUiResponsiveContentPadding">

        <content>

            <VBox width="100%" class="sapUiSmallMarginBottom">

                <!-- Smart Filter Bar -->
                <smartFilterBar:SmartFilterBar
                    id="smartFilterBar"
                    entitySet="Cases"
                    persistencyKey="DisciplinaryEmployeeFilter"
                    useToolbar="false"
                    showGoOnFB="true"
                    showClearOnFB="true"
                    search="onSearch"
                    enableBasicSearch="true">

                </smartFilterBar:SmartFilterBar>

                <!-- Employee Case Smart Table -->               
                <smartTable:SmartTable
                    id="employeeSmartTable"
                    entitySet="Cases"
                    tableType="Table"
                    header="Cases"
                    showRowCount="true"
                    enableAutoBinding="true"
                    useVariantManagement="false"
                    useTablePersonalisation="true"
                    useExportToExcel="true"
                    persistencyKey="EmployeeSmartTable"
                    demandPopin="true"
                    smartFilterId="smartFilterBar"
                    initialise=".onTableInit"
                    class="sapUiResponsiveContentPadding">

                    <smartTable:customToolbar>
                        <OverflowToolbar>
                            <ToolbarSpacer/>

                            <Button
                                text="Create Case"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press="onCreateEmployee"/>
                        </OverflowToolbar>
                    </smartTable:customToolbar>

 <!-- Grid table with two custom columns -->
    <ui:Table>
        <ui:columns>

            <!-- Case ID as hyperlink -->
            <ui:Column
                id="colCaseID"
                width="10rem"
                sortProperty="caseID"
                filterProperty="caseID">
                <ui:customData>
                    <core:CustomData key="p13nData"
                        value='\{"columnKey":"caseID","leadingProperty":"caseID","sortProperty":"caseID","filterProperty":"caseID"}'/>
                </ui:customData>
                <Label text="{i18n>caseID}"/>
                <ui:template>
                    <Link text="{caseID}" press=".onCaseIDPress"/>
                </ui:template>
            </ui:Column>

             <!-- Case Status with colour and icon -->
            <ui:Column
                id="colStatus"
                width="14rem"
                sortProperty="status_statusCode"
                filterProperty="status_statusCode">
                <ui:customData>
                    <core:CustomData key="p13nData"
                        value='\{"columnKey":"status_statusCode","leadingProperty":"status_statusCode","sortProperty":"status_statusCode","filterProperty":"status_statusCode"}'/>
                </ui:customData>
                <Label text="{i18n>caseStatus}"/>
                <ui:template>
                    <ObjectStatus
                        text="{path: 'status_statusCode', formatter: '.formatter.statusText'}"
                        state="{path: 'status_statusCode', formatter: '.formatter.statusState'}"
                        icon="{path: 'status_statusCode', formatter: '.formatter.statusIcon'}"
                        inverted="true"/>
                </ui:template>
            </ui:Column>


          


           
        </ui:columns>
    </ui:Table>

                </smartTable:SmartTable>


            </VBox>

        </content>
    </Page>

</mvc:View>
